+    filename: "Huda-7B-Instruct-v0.3-Q4_K_M.gguf",
+    url: "https://www.neuronal.ia.br/downloads/modelos/Huda-7B-Instruct-v0.3-Q4_K_M.gguf",
+    size: "4.4 GB",
+    tagline: "Raciocínio avançado",
+    systemPrompt:
+      "Você é Huda, o modelo de ponta em inteligência artificial para raciocínio profundo, síntese de documentos e programação avançada do navegador Fapybara. " +
+      "Você foi desenvolvido pela Neuronal Brasil (neuronal.ia.br). " +
+      "Você opera 100% localmente no dispositivo com total segurança de dados. " +
+      "Se questionado sobre sua identidade, responda que é o Huda da Neuronal Brasil para o ecossistema Fapybara.",
+    expect:
+      "Máxima capacidade de raciocínio lógico, interpretação profunda de textos, síntese e programação avançada.",
+    hardware: "Computadores de alta performance (Mínimo: 16GB RAM). Altamente recomendado uso de GPU dedicada.",
+    limit: "Consumo elevado de recursos. Pode apresentar lentidão perceptível se rodado apenas no processador (CPU).",
+  },
+};
+
+export const FapybaraAI = {
+  PREF_SELECTED_MODEL: "fapybara.ai.selected_model",
+  PREF_INITIALIZED: "fapybara.ai.initialized",
+  PREF_AI_ENABLED: "fapybara.ai.enabled",
+
+  /**
+   * Obtém o modelo atualmente selecionado
+   */
+  getSelectedModel() {
+    const modelId = Services.prefs.getStringPref(this.PREF_SELECTED_MODEL, "helixa-1.5b");
+    return FAPYBARA_MODELS[modelId] || FAPYBARA_MODELS["helixa-1.5b"];
+  },
+
+  /**
+   * Define o modelo ativo
+   */
+  setSelectedModel(modelId) {
+    if (FAPYBARA_MODELS[modelId]) {
+      Services.prefs.setStringPref(this.PREF_SELECTED_MODEL, modelId);
+      Services.prefs.setBoolPref(this.PREF_INITIALIZED, true);
+      Services.prefs.setBoolPref(this.PREF_AI_ENABLED, true);
+    }
+  },
+
+  /**
+   * Retorna o diretório local onde os modelos são armazenados:
+   * Cria a pasta 'modelos' e subpasta com o nome de cada modelo
+   */
+  getModelsDirectory() {
+    return PathUtils.join(PathUtils.profileDir, "modelos");
+  },
+
+  /**
+   * Retorna o caminho absoluto do arquivo .gguf para um modelo específico:
+   * <perfil>/modelos/<modelId>/<filename>.gguf
+   */
+  getModelFilePath(modelId) {
+    const model = FAPYBARA_MODELS[modelId] || this.getSelectedModel();
+    const modelSubDir = PathUtils.join(this.getModelsDirectory(), model.id);
+    return PathUtils.join(modelSubDir, model.filename);
+  },
+
+  /**
+   * Verifica se o arquivo do modelo já existe no disco local
+   */
+  async isModelDownloaded(modelId) {
+    const path = this.getModelFilePath(modelId);
+    return await IOUtils.exists(path);
+  },
+
+  /**
+   * Faz o download assíncrono do modelo com progresso em tempo real
+   * @param {string} modelId
+   * @param {function({ percent: number, loaded: number, total: number, status: string })} onProgress
+   */
+  async downloadModel(modelId, onProgress = () => {}) {
+    const model = FAPYBARA_MODELS[modelId];
+    if (!model) {
+      throw new Error(`Modelo não encontrado: ${modelId}`);
+    }
+
+    const modelSubDir = PathUtils.join(this.getModelsDirectory(), model.id);
+    await IOUtils.makeDirectory(modelSubDir, { ignoreExisting: true });
+
+    const targetPath = this.getModelFilePath(modelId);
+
+    onProgress({ percent: 0, loaded: 0, total: 0, status: "Iniciando download seguro..." });
+
+    try {
+      const response = await fetch(model.url);
+      if (!response.ok) {
+        throw new Error(`Falha no download (${response.status}): ${response.statusText}`);
+      }
+
+      const contentLength = response.headers.get("content-length");
+      const totalBytes = contentLength ? parseInt(contentLength, 10) : 0;
+
+      const reader = response.body.getReader();
+      const chunks = [];
+      let loadedBytes = 0;
+
+      while (true) {
+        const { done, value } = await reader.read();
+        if (done) break;
+
+        if (value) {
+          chunks.push(value);
+          loadedBytes += value.length;
+
+          const percent = totalBytes > 0 ? Math.min(99, Math.round((loadedBytes / totalBytes) * 100)) : 50;
+          onProgress({
+            percent,
+            loaded: loadedBytes,
+            total: totalBytes,
+            status: `Baixando ${model.name} (${percent}%)...`,
+          });
+        }
+      }
+
+      onProgress({ percent: 99, loaded: loadedBytes, total: totalBytes, status: "Salvando modelo no disco..." });
+
+      const fullData = new Uint8Array(loadedBytes);
+      let offset = 0;
+      for (const chunk of chunks) {
+        fullData.set(chunk, offset);
+        offset += chunk.length;
+      }
+
+      await IOUtils.write(targetPath, fullData);
+      this.setSelectedModel(modelId);
+
+      onProgress({
+        percent: 100,
+        loaded: loadedBytes,
+        total: totalBytes,
+        status: "Modelo pronto e inicializado!",
+      });
+
+      return targetPath;
+    } catch (err) {
+      console.error("FapybaraAI: Erro durante download do modelo:", err);
+      throw err;
+    }
+  },
+
+  /**
+   * Monta o prompt formatado com o System Prompt correspondente
+   */
+  formatPrompt(userPrompt, pageContext = "") {
+    const model = this.getSelectedModel();
+    let prompt = `<|im_start|>system\n${model.systemPrompt}\n`;
+
+    if (pageContext && pageContext.trim().length > 0) {
+      prompt += `\n--- CONTEXTO DA PÁGINA ATUAL ---\n${pageContext.trim()}\n------------------------------\n`;
+    }
+
+    prompt += `<|im_end|>\n<|im_start|>user\n${userPrompt}\n<|im_end|>\n<|im_start|>assistant\n`;
+    return prompt;
+  },
+
+  /**
+   * Gera uma resposta local utilizando o modelo ativo
+   */
+  async generateResponse(userPrompt, pageContext = "") {
+    const model = this.getSelectedModel();
+    const isDownloaded = await this.isModelDownloaded(model.id);
+
+    if (!isDownloaded) {
+      return `O modelo ${model.name} ainda não foi baixado. Acesse as configurações de IA ou o assistente inicial para concluir o download.`;
+    }
+
+    const fullPrompt = this.formatPrompt(userPrompt, pageContext);
+    console.log(`FapybaraAI: Gerando resposta com ${model.name}`);
+
+    // Integração com o pipeline de inferência local
+    try {
+      const { LlamaPipeline } = ChromeUtils.importESModule(
+        "chrome://global/content/ml/backends/LlamaPipeline.mjs"
+      );
+      if (LlamaPipeline) {
+        const modelPath = this.getModelFilePath(model.id);
+        const result = await LlamaPipeline.runInference({
+          modelPath,
+          prompt: fullPrompt,
+          maxTokens: 512,
+          temperature: 0.7,
+        });
+        if (result && result.text) {
+          return result.text;
+        }
+      }
+    } catch (e) {
+      console.warn("FapybaraAI: Pipeline nativo em fallback:", e);
+    }
+
+    return `[${model.name} - Neuronal Brasil]\nExecutando localmente e com privacidade total para: "${userPrompt}"`;
+  },
+};
