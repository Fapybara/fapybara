+// Otimização Estrita de Processos e Memória RAM (Fapybara 4-Core / 8-Thread Optimized)
+// 1. Desativa a fragmentação de processos por site (Fission), voltando ao pool global e10s
+pref("fission.autostart", false);
+
+// 2. Limite global estrito de processos de conteúdo web (compartilhado por todas as abas)
+pref("dom.ipc.processCount", 4);
+pref("dom.ipc.processCount.webIsolated", 1);
+pref("dom.ipc.processCount.file", 1);
+pref("dom.ipc.processCount.extension", 1);
+pref("dom.ipc.processCount.privilegedabout", 1);
+pref("dom.ipc.processCount.privilegedmozilla", 1);
+
+// 3. Desativa completamente a pré-criação de processos ociosos (Prelaunch)
+pref("dom.ipc.processPrelaunch.enabled", false);
+pref("dom.ipc.processPrelaunch.fission.number", 0);
+
+// 4. Força subframes/iframes a reutilizarem processos já abertos
+pref("browser.tabs.remote.subframesPreferUsed", true);
+
+// 5. Otimização de processos de rede e decodificação de mídia
+pref("media.utility-process.enabled", true);
+pref("media.rdd-process.enabled", true);
+pref("network.process.enabled", false);
+pref("media.autoplay.default", 0);
+pref("media.autoplay.blocking_policy", 0);
+
+// 6. Elimina a retenção de processos fechados na memória
+pref("dom.ipc.keepProcessesAlive.privilegedabout", 0);
+pref("dom.ipc.processReuse.unusedGraceMs", 0);
+
+// 7. Bloqueio definitivo de temas de terceiros / AMO para blindar o Fapybara Theme Mixer
+pref("extensions.activeThemeID", "default-theme@mozilla.org");
+pref("services.sync.prefs.sync.extensions.activeThemeID", false);
+pref("extensions.webextensions.themes.enabled", false);
+
+// 8. Ativação nativa da Barra Lateral de IA (Fapybara AI Chat)
+pref("sidebar.revamp", true);
+pref("sidebar.main.tools", "aichat,syncedtabs,history,bookmarks");
+pref("sidebar.visibility", "always-show");
+pref("browser.ml.enable", true);
+pref("browser.ml.chat.enabled", true);
+pref("browser.ml.chat.sidebar", true);
+pref("browser.ml.pageAssist.enabled", true);
+pref("browser.ml.chat.provider", "helixa-1.5b");
